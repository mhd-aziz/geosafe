{
  "name": "geosafe-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GeoSafe web GIS frontend: peta sebaran titik panas karhutla Indonesia",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
